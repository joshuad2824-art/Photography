# Signs the admin and client-gallery cookies. 32+ random characters.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# The one shared password behind the footer's "Admin" control.
ADMIN_PASSWORD=

# Where the copy store, client-gallery records and portrait uploads are written.
# Defaults to ./data. Point this at a persistent volume in production.
# DATA_DIR=/var/lib/joshua-davis

# --- Backups (production only; see docs/BACKUP.md) ---------------------------
# Unset means nothing is backed up. The site still runs and says so in the log.
# RESTIC_REPOSITORY=s3:https://s3.us-west-004.backblazeb2.com/your-bucket
# RESTIC_PASSWORD=          # encrypts the repository. Lose it and the backups
#                           # are unreadable — no provider can recover it.
# AWS_ACCESS_KEY_ID=        # bucket-scoped application key id
# AWS_SECRET_ACCESS_KEY=    # bucket-scoped application key
